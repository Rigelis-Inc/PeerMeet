<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="MiniZoom — secure video rooms. Join in seconds.">
  <title>MiniZoom — Secure video rooms</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <main class="page">
    <nav class="topnav" aria-label="Primary">
      <span class="brand"><span class="logo">◉</span><span>MiniZoom<small>Video rooms</small></span></span>
      <span class="spacer"></span>
      <span class="navlink">Secure video rooms</span>
    </nav>
    <div class="card">
      <span class="eyebrow">Getting started</span>
      <h1>Start a video room in seconds.</h1>
      <p class="sub">Enter your display name to continue. Then join a scheduled event or jump straight into a room.</p>
      <label class="field" for="name">
        Display name
        <input id="name" type="text" maxlength="20" placeholder="e.g. Ada Lovelace" autocomplete="name">
      </label>
      <label class="field" for="room">
        Room ID <span class="hint">(optional — you can also pick one in the lobby)</span>
        <input id="room" type="text" placeholder="e.g. team-standup" autocomplete="off" spellcheck="false">
      </label>
      <div class="row">
        <button id="lobbyBtn" style="flex:2">Continue →</button>
      </div>
      <div class="row">
        <button id="joinBtn" type="button" class="secondary" style="flex:1">Join room</button>
      </div>
      <p id="err" class="err" role="alert"></p>
    </div>
  </main>
  <script>
    const nameEl = document.getElementById('name');
    const roomEl = document.getElementById('room');
    const errEl = document.getElementById('err');

    function getName() { return nameEl.value.trim() || 'Guest'; }

    function goLobby() {
      window.location.href = '/lobby?name=' + encodeURIComponent(getName());
    }

    function go(room) {
      const name = getName();
      room = (room || roomEl.value.trim());
      if (!room) { errEl.textContent = 'Enter a room ID, or press Continue to browse the lobby.'; roomEl.focus(); return; }
      window.location.href = '/' + encodeURIComponent(room) + '?name=' + encodeURIComponent(name);
    }

    document.getElementById('lobbyBtn').onclick = goLobby;
    document.getElementById('joinBtn').onclick = () => go();
    roomEl.addEventListener('keydown', e => { if (e.key === 'Enter') go(); });
    nameEl.addEventListener('keydown', e => { if (e.key === 'Enter') goLobby(); });
    nameEl.focus();
  </script>
</body>
</html>
